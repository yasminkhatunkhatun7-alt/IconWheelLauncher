<?xml version="1.0" encoding="utf-8"?><!--
   Sample data-extraction rules. In your app, you may want to back up files
   so that a user can easily restore them on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
